# Local-to-rag/ ignores. The root .gitignore already covers __pycache__/,
# *.py[cod], *.egg-info/, .venv/, and labmind-data/chromadb/* — those don't
# need to be repeated here.

# pytest test discovery cache
.pytest_cache/

# coverage artifacts (if anyone runs pytest --cov locally)
.coverage
htmlcov/

# editor scratch
.vscode/
.idea/
